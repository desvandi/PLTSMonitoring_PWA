# =============================================================================
# PLTS Monitor PWA — Environment Variables
# =============================================================================
# Copy this file to `.env.local` for local dev, or set these in your hosting
# provider's dashboard (Vercel: Settings → Environment Variables) for prod.
#
# This PWA is MONITORING-ONLY. There are no relays or actuators to control.
# =============================================================================

# -----------------------------------------------------------------------------
# API base URL (LAN mode — optional)
# -----------------------------------------------------------------------------
# Set to the ESP32 firmware REST API base URL (LAN/Cloudflare Tunnel) to enable
# direct REST mode (JWT + CSRF auth).
# Leave EMPTY for MQTT-only mode (recommended — works from anywhere, even
# behind CGNAT/MiFi, no port forwarding required).
# Example: NEXT_PUBLIC_API_BASE_URL=https://plts-tunnel.example.com
NEXT_PUBLIC_API_BASE_URL=

# -----------------------------------------------------------------------------
# Google Apps Script URL — DEPRECATED for browser use
# -----------------------------------------------------------------------------
# Phase 2.1 (Blocker Closure Directive 2026-08-20): the PWA browser MUST NOT
# call GAS directly. The PWA fetches insights from the ESP32's authenticated
# /api/insights endpoint, which proxies the request to GAS using the device
# HMAC secret stored in NVS (never exposed to the browser).
#
# To enable AI insights:
#   1. Deploy Code.gs (from the firmware repo's code.gs/Code.gs) as a GAS Web App.
#   2. Set GAS_INSIGHTS_URL in firmware Config.h to the deployment URL.
#   3. Set GEMINI_API_KEY in GAS Script Properties.
#   4. The ESP32 will handle authenticated GET to GAS on behalf of the PWA.
#
# This env var is retained ONLY for backward compatibility with server-side
# Next.js routes. It MUST NOT be read by browser-side code.
# Example: NEXT_PUBLIC_GAS_INSIGHTS_URL=https://script.google.com/macros/s/AKfyc.../exec
NEXT_PUBLIC_GAS_INSIGHTS_URL=

# -----------------------------------------------------------------------------
# MQTT Broker URL
# -----------------------------------------------------------------------------
# Configure for production (self-hosted broker with TLS auth).
# Phase 10 (Blocker Closure Directive 2026-08-20): production builds MUST NOT
# use a public broker. The firmware's PRODUCTION_BUILD flag rejects the default
# public brokers (broker.hivemq.com / broker.emqx.io / test.mosquitto.org /
# public.mqtthq.com) with FATAL. Set this to your self-hosted broker with TLS.
# Development/staging may use the public broker for convenience.
# Example: NEXT_PUBLIC_MQTT_BROKER_URL=wss://your-broker.com:8884/mqtt
NEXT_PUBLIC_MQTT_BROKER_URL=

# -----------------------------------------------------------------------------
# MQTT Broker viewer credentials — SERVER-HELD (audit p.486-old / GATE-3 S1-01)
# -----------------------------------------------------------------------------
# [GATE-3 / S1-01 2026-09] The ONLY credential path: served to authenticated
# sessions via /api/mqtt/credentials — NEVER inlined into the public browser
# bundle (the NEXT_PUBLIC_* fallback is deleted; the production config gate
# FAILS the build if either NEXT_PUBLIC_MQTT_* credential variable is set).
# Provision this pair as a dedicated VIEWER account on the broker:
# ACL = READ-ONLY on plts/<deviceId>/# (status/log/online), nothing else.
# Rotation = server-side env change only (no rebuild).
MQTT_USERNAME=
MQTT_PASSWORD=


# -----------------------------------------------------------------------------
# JWT revocation shared store (audit p.479) — Upstash Redis REST
# -----------------------------------------------------------------------------
# Vercel serverless runs MULTIPLE instances: a process-local logout blacklist
# is per-instance, so a stolen JWT stays valid on other instances until
# expiry. Configure an Upstash Redis REST database to make logout revocation
# GLOBAL. Without these vars the app falls back to process-local revocation
# with a startup warning (single-instance semantics — residual risk).
# Create a free database at https://upstash.com → copy REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# GAS origin allowlist extension (audit p.488)
# -----------------------------------------------------------------------------
# Credential-bearing GAS requests are restricted to script.google.com /
# script.googleusercontent.com by default (strict allowlist + redirect:'error').
# Add extra hosts ONLY for a self-hosted GAS mirror you control (comma
# separated). Leave empty for standard Google Apps Script deployments.
NEXT_PUBLIC_GAS_ALLOWED_HOSTS=

# -----------------------------------------------------------------------------
# JWT Secret (required only if using LAN REST API)
# -----------------------------------------------------------------------------
# In production without this: mock auth is disabled (LAN login returns 403).
# For MQTT-only mode (no REST): leave empty (JWT not used).
# Minimum length: 32 chars.
JWT_SECRET=

# -----------------------------------------------------------------------------
# Demo mode (development only)
# -----------------------------------------------------------------------------
# Set to "true" to enable mock API with demo credentials (admin/admin123).
# Use NEXT_PUBLIC_DEMO_MODE (recommended) so the frontend can also detect it
# and hide the disabled LAN login form.
#
# WARNING: In production (NODE_ENV=production), DEMO_MODE is FORCIBLY disabled
# regardless of this env var. The mock auth fail-closed guard in mockStore.ts
# prevents demo credentials from ever being accepted in production.
# NEVER set DEMO_MODE=true in production — it has no effect and the security
# guard will log a CRITICAL warning.
DEMO_MODE=
NEXT_PUBLIC_DEMO_MODE=

# -----------------------------------------------------------------------------
# Serwist dev mode (optional)
# -----------------------------------------------------------------------------
# Set to "true" to enable service worker in dev mode (faster PWA testing).
# By default, the SW is disabled in dev to avoid caching stale HMR assets.
SERWIST_DEV=

# -----------------------------------------------------------------------------
# Release channel + authorized firmware tag [Audit 2026-09-05 re-audit, P1-5]
# -----------------------------------------------------------------------------
# POLICY INVARIANT — do not set NEXT_PUBLIC_EXPECTED_FIRMWARE_TAG in
# production. The authorized production release tag is pinned in
# release-policy.json (authorizedProductionTag) and enforced by
# src/lib/release-policy.ts + scripts/validate-production-config.mjs + the CI
# production-config-gate job. A production build with a DIFFERENT tag in
# NEXT_PUBLIC_EXPECTED_FIRMWARE_TAG FAILS (build error), not a warning.
#
# To test a pre-release firmware channel, explicitly opt in:
#   NEXT_PUBLIC_RELEASE_CHANNEL=staging
#   NEXT_PUBLIC_EXPECTED_FIRMWARE_TAG=v1.9.4   (well-formed vX.Y.Z only)
# Staging overrides never authorize production fleet OTA by themselves — the
# device still verifies SHA-256 + Ed25519 signature before flashing.
NEXT_PUBLIC_RELEASE_CHANNEL=
NEXT_PUBLIC_EXPECTED_FIRMWARE_TAG=
